# Keep the pinned plugin-dc sources untouched. Its piDC::Init currently queries
# OpenGL even for a wxDC, which crashes macOS software rendering without a GL
# context. Compile a build-local copy with GL initialization limited to GL DCs.
function(wr_guard_software_drawing_context)
  if(NOT TARGET _DC_UTILS)
    message(FATAL_ERROR "Cannot guard software drawing: _DC_UTILS is unavailable")
  endif()
  get_target_property(already_guarded _DC_UTILS WR_SOFTWARE_CONTEXT_GUARDED)
  if(already_guarded)
    return()
  endif()
  get_target_property(dc_dir _DC_UTILS SOURCE_DIR)
  get_target_property(dc_sources _DC_UTILS SOURCES)
  set(guarded_sources)
  set(found FALSE)
  foreach(source IN LISTS dc_sources)
    if(source MATCHES "(^|/)pidc\\.cpp$")
      if(IS_ABSOLUTE "${source}")
        set(original "${source}")
      else()
        set(original "${dc_dir}/${source}")
      endif()
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}")
      file(READ "${original}" contents)
      set(before "  //if (glcontext)\n  {\n    GLint parms[2];")
      string(FIND "${contents}" "${before}" position)
      if(position EQUAL -1)
        message(FATAL_ERROR "plugin-dc initialization changed; review its software-context guard")
      endif()
      string(REPLACE "${before}" "  if (!dc) {\n    GLint parms[2];" guarded "${contents}")
      set(generated "${CMAKE_CURRENT_BINARY_DIR}/software-dc/pidc.cpp")
      file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/software-dc")
      set(previous "")
      if(EXISTS "${generated}")
        file(READ "${generated}" previous)
      endif()
      if(NOT previous STREQUAL guarded)
        file(WRITE "${generated}" "${guarded}")
      endif()
      list(APPEND guarded_sources "${generated}")
      set(found TRUE)
    else()
      list(APPEND guarded_sources "${source}")
    endif()
  endforeach()
  if(NOT found)
    message(FATAL_ERROR "Cannot locate the pinned plugin-dc implementation")
  endif()
  set_property(TARGET _DC_UTILS PROPERTY SOURCES "${guarded_sources}")
  set_property(TARGET _DC_UTILS PROPERTY WR_SOFTWARE_CONTEXT_GUARDED TRUE)
endfunction()
