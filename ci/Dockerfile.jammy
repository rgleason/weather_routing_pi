ARG BASE_IMAGE=ubuntu:22.04
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
RUN printf '%s\n' 'Acquire::Retries "6";' 'Acquire::http::Timeout "30";' \
    'APT::Update::Error-Mode "any";' > /etc/apt/apt.conf.d/90-ci-downloads
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
# The OpenCPN PPA serves the host wxWidgets 3.2 ABI on Jammy.
COPY opencpn-ppa.asc /usr/share/keyrings/opencpn-ppa.asc
RUN printf '%s\n' \
    'deb [signed-by=/usr/share/keyrings/opencpn-ppa.asc] http://ppa.launchpad.net/opencpn/opencpn/ubuntu jammy main' \
    > /etc/apt/sources.list.d/opencpn.list
COPY install-debian-build-deps.sh /usr/local/bin/
RUN /usr/local/bin/install-debian-build-deps.sh
